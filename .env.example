# ============================================================
# GottaVital - Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# ---- Evolution API (WhatsApp gateway) ----
# Cámbiala por una clave aleatoria larga. Ejemplo de generar:
#   openssl rand -hex 32
EVOLUTION_API_KEY=cambia-esto-por-una-clave-aleatoria-larga

# ---- PostgreSQL ----
POSTGRES_USER=evolution
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=evolution

# ---- Groq API (LLM) ----
# Consíguela gratis en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_de_groq_aqui

# ---- Google Sheets ----
# El ID está en la URL: https://docs.google.com/spreadsheets/d/[ESTE_ID]/edit
GOOGLE_SHEETS_ID=tu_id_de_google_sheets_aqui

# ---- Zona horaria ----
TZ=America/Bogota
